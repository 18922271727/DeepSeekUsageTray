<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeepSeekUsageTray</RootNamespace>
    <AssemblyName>DeepSeekUsageTray</AssemblyName>
    <Version>0.2.0</Version>
    <ApplicationIcon>whale.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <EmbeddedResource Include="whale.png" />
    <EmbeddedResource Include="whale.ico" />
  </ItemGroup>

  <!-- 显式引用 WebView2 托管程序集，避免某些环境下 NuGet 的 buildTransitive
       导入因相对缓存路径而失效（正常环境下因 Exists 条件会自动跳过）。 -->
  <ItemGroup Condition="'$(PkgMicrosoft_Web_WebView2)' != ''">
    <Reference Include="Microsoft.Web.WebView2.Core"
               Condition="Exists('$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll')">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"
               Condition="Exists('$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll')">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
